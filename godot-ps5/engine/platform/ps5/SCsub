#!/usr/bin/env python
from misc.utility.scons_hints import *
Import("env")
# This is a static engine archive, NOT an installable PS5 game or eboot.bin.
# Stable runtime remains headless; opt in to the native DisplayServer ABI
# probe only for the isolated cross-compile, never the regular PS5 title.
import os
sources = ["os_ps5.cpp", "godot_ps5.cpp", "file_access_ps5.cpp", "pad_ps5.cpp", "compat.cpp"]
if os.environ.get("GODOT_PS5_AUDIOOUT") == "1":
    sources.append("audio_driver_ps5.cpp")
if os.environ.get("GODOT_PS5_DISPLAY_EXPERIMENT") == "1":
    sources.append("display_server_ps5.cpp")
env.add_library("#bin/godot_ps5", sources)
if os.environ.get("GODOT_PS5_GLES3_ARCHIVES") == "1":
    # Build the upstream GLAD loader functions as a separate PS5-native
    # archive. No app or GPL graphics stack is linked into the default title.
    env.add_library("#bin/godot_ps5_glad", [
        "#thirdparty/glad/gl.c",
        "#thirdparty/glad/egl.c",
    ])
